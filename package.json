{
  "name": "quality-guardian-system",
  "version": "0.2.3",
  "private": true,
  "keywords": [
    "quality",
    "management",
    "system",
    "qms",
    "quality guardian"
  ],
  "homepage": "",
  "bugs": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:antd": "pnpm run build --filter=@qgs/web-antd",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm run check:qms-arch && pnpm run check:qms-api-envelope && pnpm run check:qgs-domain-boundary && pnpm run check:i18n && pnpm run check:dict-governance && pnpm run check:dict-label-fallback && pnpm run check:audit-template-governance && pnpm run check:master-data-governance && pnpm run check:master-data-registry-policy && pnpm run check:master-data-backlog && pnpm run check:master-data-pending-by-module && pnpm run check:master-data-excluded-freeze && pnpm run check:master-data-quantified-baseline && pnpm run check:master-data-helper-alignment && pnpm run check:master-data-helper-surface && pnpm run check:master-data-deferred-write-paths && pnpm run check:master-data-template && pnpm run check:master-data-write-coverage && pnpm run check:master-data-read-coverage && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint **/*.ts **/README.md .changeset/*.md --no-progress",
    "check:qms-arch": "bash ./scripts/check-qms-architecture.sh",
    "check:qms-arch:all": "bash ./scripts/check-qms-architecture.sh --all",
    "check:qms-api-envelope": "node ./scripts/check-qms-api-envelope.mjs",
    "check:qgs-domain-boundary": "node ./scripts/check-qgs-domain-boundary.mjs",
    "check:i18n": "node ./scripts/check-i18n-consistency.mjs",
    "check:dict-governance": "node ./scripts/check-dictionary-governance.mjs",
    "check:dict-label-fallback": "node ./scripts/check-dictionary-label-fallback.mjs",
    "check:audit-template-governance": "node ./scripts/check-audit-template-governance.mjs",
    "check:master-data-governance": "node ./scripts/check-master-data-governance.mjs",
    "check:master-data-registry-policy": "pnpm --dir apps/backend run db:check-master-data-registry-policy",
    "check:master-data-backlog": "pnpm --dir apps/backend run db:check-master-data-backlog",
    "check:master-data-pending-by-module": "pnpm --dir apps/backend run db:check-master-data-pending-by-module",
    "check:master-data-excluded-freeze": "pnpm --dir apps/backend run db:check-master-data-excluded-freeze",
    "check:master-data-quantified-baseline": "pnpm --dir apps/backend run db:check-master-data-quantified-baseline",
    "check:master-data-acceptance": "pnpm --dir apps/backend run db:check-master-data-acceptance",
    "check:master-data-objective-audit": "pnpm --dir apps/backend run db:check-master-data-objective-audit",
    "check:master-data-helper-alignment": "pnpm --dir apps/backend run db:check-master-data-helper-alignment",
    "check:master-data-helper-surface": "pnpm --dir apps/backend run db:check-master-data-helper-surface",
    "check:master-data-generic-write-entry": "pnpm --dir apps/backend run db:check-master-data-generic-write-entry",
    "check:master-data-deferred-write-paths": "pnpm --dir apps/backend run db:check-master-data-deferred-write-paths",
    "check:master-data-template": "pnpm --dir apps/backend run db:verify-governance-template --all=true --executeCanonical=false",
    "check:master-data-write-coverage": "pnpm --dir apps/backend run db:audit-master-data-write-coverage",
    "check:master-data-read-coverage": "pnpm --dir apps/backend run db:audit-master-data-read-coverage",
    "fix:master-data-orphans": "pnpm --dir apps/backend run db:repair-master-data-orphans --dryRun=false",
    "export:master-data-canonicalization-plan": "pnpm --dir apps/backend run db:export-master-data-canonicalization-plan",
    "check:master-data-release-gate": "node ./scripts/check-master-data-release-gate.mjs",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "local:rbac": "bash ./scripts/local/rbac-local-one-click.sh",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:antd": "turbo run dev --parallel --filter=@qgs/web-antd --filter=@qgs/backend",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "catalog": "pnpx codemod pnpm/catalog"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/prettier-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "catalog:",
    "autoprefixer": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "^4.21.0",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "*"
      }
    },
    "overrides": {
      "@ast-grep/napi": "catalog:",
      "@ctrl/tinycolor": "catalog:",
      "clsx": "catalog:",
      "esbuild": "0.25.3",
      "pinia": "catalog:",
      "vue": "catalog:"
    },
    "neverBuiltDependencies": [
      "canvas",
      "node-gyp"
    ]
  }
}
