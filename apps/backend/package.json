{
  "name": "@qgs/backend",
  "version": "1.0.0",
  "description": "Backend service for Quality Guardian System",
  "private": true,
  "homepage": "https://www.tolian-tech.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajie5419/Quality-Guardian.git",
    "directory": "apps/backend"
  },
  "license": "MIT",
  "author": "Zhao XiaoJie",
  "scripts": {
    "build": "nitro build",
    "dev": "cross-env NODE_ENV=development PORT=5320 nitro dev",
    "start": "nitro dev",
    "stub": "prisma generate --schema=./prisma/schema.prisma && nitro prepare",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "maintenance:team-identities": "tsx scripts/reconcile-team-identities.ts",
    "maintenance:team-merge": "TEAM_IDENTITY_MAINTENANCE_MODE=1 tsx scripts/merge-team-identities.ts",
    "maintenance:team-merge-confirmed": "TEAM_IDENTITY_MAINTENANCE_MODE=1 tsx scripts/merge-confirmed-team-duplicates.ts",
    "maintenance:inspection-request-categories": "tsx scripts/backfill-inspection-request-categories.ts",
    "maintenance:inspection-request-responsibilities": "tsx scripts/backfill-inspection-request-responsibilities.ts",
    "maintenance:inspection-request-process-options": "tsx scripts/backfill-inspection-request-process-options.ts",
    "maintenance:quality-classifications": "tsx scripts/backfill-quality-classifications.ts",
    "maintenance:inspection-issue-divisions": "tsx scripts/backfill-inspection-issue-divisions.ts",
    "maintenance:inspection-issue-responsibilities": "tsx scripts/backfill-inspection-issue-responsibilities.ts",
    "maintenance:process-responsible-departments": "tsx scripts/backfill-process-responsible-department.ts",
    "maintenance:inspection-issue-responsibility-remediation": "tsx scripts/remediate-inspection-issue-responsibilities.ts",
    "maintenance:role-page-permissions": "tsx scripts/backfill-role-page-permissions.ts",
    "maintenance:work-order-confirm-permission": "tsx scripts/backfill-work-order-confirm-permission.ts",
    "maintenance:supplier-score-snapshots": "tsx scripts/reconcile-supplier-score-snapshots.ts",
    "maintenance:supplier-identities": "tsx scripts/backfill-quality-record-supplier-identities.ts",
    "maintenance:quality-loss-index:enqueue": "tsx scripts/enqueue-quality-loss-index.ts",
    "maintenance:quality-loss-index:drain": "tsx scripts/drain-quality-loss-index.ts",
    "maintenance:welder-score:enqueue": "tsx scripts/enqueue-welder-score.ts",
    "maintenance:welder-score:drain": "tsx scripts/drain-welder-score.ts",
    "maintenance:welder-score:backfill-ids": "tsx scripts/backfill-quality-record-responsible-welder-ids.ts",
    "maintenance:welder-score:remediate-names": "tsx scripts/remediate-quality-record-responsible-welder-names.ts",
    "maintenance:welder-score:remediate-departments": "tsx scripts/remediate-quality-record-responsible-departments.ts",
    "maintenance:backfill-thumbnails": "tsx scripts/backfill-missing-thumbnails.ts",
    "maintenance:release": "tsx scripts/run-release-maintenance.ts"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "6.2.1",
    "@qgs/shared": "workspace:*",
    "ali-oss": "^6.23.0",
    "bcrypt": "^6.0.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "catalog:",
    "nanoid": "^5.0.0",
    "nitropack": "catalog:",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prisma": "6.2.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "catalog:",
    "@types/qrcode": "^1.5.5",
    "h3": "catalog:"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
