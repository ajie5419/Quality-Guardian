generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model inspections {
  id                  String                    @id @default(cuid())
  serialNumber        String?                   @unique
  category            inspection_category
  workOrderNumber     String
  projectName         String?
  projectId           String?
  supplierName        String?
  supplierId          String?
  materialName        String?
  materialNameId      String?
  incomingType        String?
  incomingTypeId      String?
  processName         String?
  processId           String?
  teamId              String?
  level1Component     String?
  level2Component     String?
  team                String?
  documents           String?                   @db.LongText
  hasDocuments        Boolean                   @default(true)
  packingListArchived String?
  quantity            Int                       @default(1)
  qualifiedQuantity   Int?
  unqualifiedQuantity Int?
  inspector           String
  templateId          String?
  templateName        String?
  inspectionDate      DateTime
  reportDate          DateTime?
  result              inspection_result         @default(PASS)
  remarks             String?                   @db.Text
  isDeleted           Boolean                   @default(false)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  items               inspection_items[]
  archiveTask         inspection_archive_tasks?
  inspectionRequest   qms_inspection_requests?
  process             processes?                 @relation(fields: [processId], references: [id], onDelete: SetNull)
  qualityRecords      quality_records[]
  work_order          work_orders               @relation(fields: [workOrderNumber], references: [workOrderNumber], onUpdate: Cascade)

  @@index([workOrderNumber])
  @@index([category])
  @@index([inspectionDate])
  @@index([processId])
  @@index([teamId])
  @@index([supplierId])
  @@index([projectId])
  @@index([materialNameId])
  @@index([incomingTypeId])
}

model inspection_items {
  id                 String            @id @default(cuid())
  inspectionId       String
  checkItem          String
  standardValue      String?
  upperTolerance     String?
  lowerTolerance     String?
  uom                String?
  acceptanceCriteria String?           @db.Text
  referenceDoc       String?
  measuredValue      String?
  result             inspection_result @default(PASS)
  remarks            String?
  order              Int               @default(0)
  inspection         inspections       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model menus {
  id        String   @id
  path      String?
  name      String?  @unique
  component String?
  redirect  String?
  meta      String?  @db.Text
  createdAt DateTime @default(now())
  status    Int      @default(1)
  type      String   @default("menu")
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  authCode  String?
  order     Int      @default(0)
  parentId  String?  @default("0")

  @@index([parentId])
}

model reports {
  id               String   @id @default(cuid())
  date             DateTime
  totalInspections Int      @default(0)
  passRate         Float    @default(0)
  majorDefects     Int      @default(0)
  minorDefects     Int      @default(0)
  status           String   @default("Draft")
  author           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model after_sales {
  id                  String                  @id
  serialNumber        Int
  occurDate           DateTime
  claimStatus         after_sales_claimStatus
  projectName         String
  projectId           String?
  productType         String?
  shipDate            DateTime?
  warrantyStatus      String?
  issueDescription    String?                 @db.Text
  quantity            Int
  feedbackDept        String?
  feedbackDeptId      String?
  solution            String?                 @db.Text
  actualSolution      String?                 @db.Text
  qualityLoss         Decimal                 @default(0.00) @db.Decimal(10, 2)
  actualClaim         Decimal                 @default(0.00) @db.Decimal(10, 2)
  respDept            String?
  responsibleDepartments String?              @db.Text // @module after-sales - JSON array
  respDeptId          String?
  supplierBrand       String?
  supplierBrandId     String?
  photos              String?                 @db.LongText
  isClaim             Boolean                 @default(false)
  remarks             String?                 @db.Text
  failureType         String?
  failureTypeId       String?
  failureCause        String?
  failureCauseId      String?
  linkedEngineeringId String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  version             Int                     @default(1)
  isDeleted           Boolean                 @default(false)
  workOrderNumber     String
  customerName        String?
  location            String?
  factoryDate         DateTime?
  handler             String?
  materialCost        Decimal?                @default(0.00) @db.Decimal(10, 2)
  laborTravelCost     Decimal?                @default(0.00) @db.Decimal(10, 2)
  closeDate           DateTime?
  defectType          String?
  defectSubtype       String?
  defectTypeId        String?
  defectSubtypeId     String?
  severity            String?
  productSubtype      String?
  productSubtypeId    String?
  productTypeId       String?
  runningHours        Decimal?
  division            String?
  divisionId          String?
  customerNameId      String?
  partName            String?
  partId              String?
  work_orders         work_orders             @relation(fields: [workOrderNumber], references: [workOrderNumber], onUpdate: Cascade)

  @@index([claimStatus])
  @@index([occurDate])
  @@index([supplierBrand])
  @@index([supplierBrandId])
  @@index([workOrderNumber])
  @@index([projectName])
  @@index([projectId])
  @@index([isDeleted])
  @@index([respDept])
  @@index([respDeptId])
  @@index([feedbackDept])
  @@index([feedbackDeptId])
  @@index([handler])
  @@index([defectType])
  @@index([defectTypeId])
  @@index([defectSubtypeId])
  @@index([division])
  @@index([divisionId])
  @@index([customerNameId])
  @@index([partId])
  @@index([productTypeId])
  @@index([productSubtypeId])
  @@index([failureTypeId])
  @@index([failureCauseId])
}

model audit_logs {
  id         String            @id @default(cuid())
  userId     String
  action     audit_logs_action
  targetType String
  targetId   String
  details    String?           @db.Text
  ipAddress  String?
  userAgent  String?           @db.Text
  timestamp  BigInt            @default(autoincrement())
  isDeleted  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  users      users             @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId])
  @@index([isDeleted])
}

model login_logs {
  id        String   @id @default(cuid())
  username  String
  ip        String?
  browser   String?
  os        String?
  device    String?
  method    String?  @default("密码登录")
  status    String?  @default("成功") // 成功 / 失败
  message   String?  @db.Text
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isDeleted])
}

model departments {
  id           String   @id
  name         String
  businessUnit String?
  description  String?
  status       Int      @default(1)
  parentId     String   @default("0")
  sort         Int      @default(0)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int      @default(1)

  @@index([parentId])
}

model dictionaries {
  id        String   @id @default(cuid())
  dictType  String
  dictKey   String
  dictValue String
  sort      Int      @default(0)
  status    Int      @default(1)
  remark    String?  @db.Text
  isSystem  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dictType])
  @@index([dictType, status])
  @@index([dictType, dictKey])
  @@unique([dictType, dictKey, isDeleted])
}

model processes {
  id                        String                      @id @default(cuid())
  name                      String                      @unique
  code                      String?
  sort                      Int                         @default(0)
  status                    Int                         @default(1)
  isDeleted                 Boolean                     @default(false)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  inspections               inspections[]
  quality_records           quality_records[]
  work_order_requirements   work_order_requirements[]
  qms_inspection_requests   qms_inspection_requests[]
  inspection_form_templates inspection_form_templates[]

  @@index([name])
  @@index([status])
}

model dfmea_projects {
  id              String                @id @default(cuid())
  projectName     String
  projectId       String?
  workOrderId     String?
  version         String                @default("V1.0")
  status          String                @default("draft")
  description     String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdBy       String                @default("admin")
  isDeleted       Boolean               @default(false)
  items           dfmea[]
  work_orders     work_orders?          @relation(fields: [workOrderId], references: [workOrderNumber], onUpdate: Cascade)
  task_dispatches qms_task_dispatches[]

  @@index([workOrderId])
  @@index([projectName])
  @@index([projectId])
  @@index([status])
}

model dfmea {
  id                String         @id @default(cuid())
  serialNumber      Int?
  item              String
  function          String?        @db.Text
  failureMode       String
  effect            String?        @db.Text
  severity          Int
  cause             String?        @db.Text
  causeId           String?
  occurrence        Int
  detection         Int
  rpn               Int
  preventionControl String?        @db.Text
  detectionControl  String?        @db.Text
  recommendedAction String?        @db.Text
  status            dfmea_status   @default(OPEN)
  responsibility    String?
  targetDate        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  version           Int            @default(1)
  isDeleted         Boolean        @default(false)
  order             Int            @default(0)
  projectId         String
  dfmea_projects    dfmea_projects @relation(fields: [projectId], references: [id])

  @@index([causeId])
  @@index([projectId])
}

model permissions {
  id          String   @id
  code        String   @unique
  name        String
  description String?
  module      String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model rbac_permissions {
  id          String                  @id
  code        String                  @unique
  name        String
  description String?
  module      String
  isDeleted   Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  roleLinks   rbac_role_permissions[]
}

model rbac_role_permissions {
  id           String           @id
  roleId       String
  permissionId String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  permission   rbac_permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         roles            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([roleId])
}

model rbac_user_roles {
  id        String   @id
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([userId])
}

model data_permission_policies {
  id          String   @id
  roleId      String
  module      String
  scopeType   String   @default("SELF")
  deptIds     String?  @db.LongText
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  role        roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([module])
  @@index([roleId])
}

model project_boms {
  id                 String      @id
  work_order_number  String
  part_name          String
  partId             String?
  part_number        String?
  material           String?
  required_processes String?     @db.LongText
  quantity           Int         @default(1)
  unit               String      @default("pcs")
  remarks            String?     @db.Text
  created_by         String?
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt
  work_orders        work_orders @relation(fields: [work_order_number], references: [workOrderNumber], onUpdate: Cascade)

  @@index([work_order_number])
  @@index([part_number])
  @@index([partId])
}

model bom_projects {
  id              String      @id @default(cuid())
  workOrderNumber String      @unique
  projectName     String
  projectId       String?
  status          String      @default("active")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  isDeleted       Boolean     @default(false)
  work_order      work_orders @relation(fields: [workOrderNumber], references: [workOrderNumber], onUpdate: Cascade)

  @@index([projectId])
}

model doc_projects {
  id              String      @id @default(cuid())
  workOrderNumber String      @unique
  projectName     String
  projectId       String?
  documents       String?     @db.LongText
  status          String      @default("active")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  isDeleted       Boolean     @default(false)
  work_order      work_orders @relation(fields: [workOrderNumber], references: [workOrderNumber], onUpdate: Cascade)

  @@index([projectId])
}

model quality_plans {
  id              String                   @id
  projectName     String
  projectId       String?
  customer        String
  customerId      String?
  documents       String?                  @db.LongText
  itpItems        String?                  @db.LongText
  planStatus      quality_plans_planStatus @default(DRAFT)
  preparedBy      String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  version         Int                      @default(1)
  isDeleted       Boolean                  @default(false)
  workOrderNumber String
  items           itp_items[]              @relation("PlanToItems")
  task_dispatches qms_task_dispatches[]
  work_orders     work_orders              @relation(fields: [workOrderNumber], references: [workOrderNumber], onUpdate: Cascade)

  @@index([planStatus])
  @@index([workOrderNumber])
  @@index([customerId])
  @@index([projectId])
}

model itp_items {
  id                 String        @id @default(cuid())
  projectId          String
  processStep        String
  processStepId      String?
  activity           String
  controlPoint       String
  acceptanceCriteria String?       @db.Text
  referenceDoc       String?       @db.Text
  frequency          String?
  verifyingDocument  String?
  isQuantitative     Boolean       @default(false)
  quantitativeItems  String?       @db.LongText
  order              Int           @default(0)
  isDeleted          Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  quality_plan       quality_plans @relation("PlanToItems", fields: [projectId], references: [id])

  @@index([projectId])
  @@index([processStep])
  @@index([processStepId])
}

model quality_records {
  id                                      String                      @id
  serialNumber                            Int
  date                                    DateTime
  status                                  quality_records_status
  partName                                String
  partId                                  String?
  description                             String?                     @db.Text
  quantity                                Int
  lossHours                               Decimal                     @default(0.00) @db.Decimal(10, 2)
  lossAmount                              Decimal                     @default(0.00) @db.Decimal(10, 2)
  projectName                             String?
  projectId                               String?
  division                                String?
  divisionId                              String?
  responsibleDepartment                   String
  responsibleDepartments                  String?                     @db.Text // @module inspection - JSON array
  responsibleDepartmentId                 String?
  responsibleBU                           String?
  inspector                               String?
  analysis                                String?                     @db.Text
  solution                                String?                     @db.Text
  issuePhoto                              String?                     @db.Text
  rectificationPhoto                      String?                     @db.Text
  isClaim                                 Boolean                     @default(false)
  nonConformanceNumber                    String?                     @unique
  lastEditor                              String?
  sourceAfterSalesId                      String?
  createdAt                               DateTime                    @default(now())
  updatedAt                               DateTime                    @updatedAt
  version                                 Int                         @default(1)
  isDeleted                               Boolean                     @default(false)
  inspectionId                            String?
  workOrderNumber                         String?
  claimNotes                              String?                     @db.Text
  claimStatus                             quality_records_claimStatus @default(OPEN)
  recoveredAmount                         Decimal                     @default(0.00) @db.Decimal(10, 2)
  hourlyRate                              Decimal                     @default(0.00) @db.Decimal(10, 2)
  supplierName                            String?
  supplierId                              String?
  category                                String?
  categoryId                              String?
  processName                             String?
  processId                               String?
  defectTypeId                            String?
  defectSubtypeId                         String?
  defectType                              String?
  defectSubtype                           String?
  responsibleWelder                       String?
  rootCause                               String?                     @db.Text
  rootCauseId                             String?
  severity                                String?
  users_quality_records_inspectorTousers  users?                      @relation("quality_records_inspectorTousers", fields: [inspector], references: [username])
  users_quality_records_lastEditorTousers users?                      @relation("quality_records_lastEditorTousers", fields: [lastEditor], references: [username])
  inspection                              inspections?                @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  process                                 processes?                  @relation(fields: [processId], references: [id], onDelete: SetNull)
  work_orders                             work_orders?                @relation(fields: [workOrderNumber], references: [workOrderNumber], onUpdate: Cascade)

  @@index([createdAt])
  @@index([date])
  @@index([inspectionId])
  @@index([inspector], map: "quality_records_inspector_fkey")
  @@index([lastEditor], map: "quality_records_lastEditor_fkey")
  @@index([partName])
  @@index([partId])
  @@index([serialNumber])
  @@index([status])
  @@index([status, isDeleted])
  @@index([workOrderNumber])
  @@index([responsibleDepartment])
  @@index([responsibleDepartmentId])
  @@index([responsibleBU])
  @@index([supplierId])
  @@index([projectId])
  @@index([divisionId])
  @@index([categoryId])
  @@index([defectType])
  @@index([defectTypeId])
  @@index([defectSubtypeId])
  @@index([processName])
  @@index([processId])
  @@index([rootCauseId])
}

model vehicle_commissioning_issues {
  id                    String    @id
  date                  DateTime
  status                String    @default("OPEN")
  partName              String?
  partId                String?
  description           String?   @db.Text
  responsibleDepartment String?
  responsibleDepartmentId String?
  projectName           String?
  projectId             String?
  workOrderNumber       String?
  severity              String?
  solution              String?   @db.Text
  issuePhoto            String?   @db.Text
  isClaim               Boolean   @default(false)
  lossAmount            Decimal   @default(0.00) @db.Decimal(10, 2)
  recoveredAmount       Decimal   @default(0.00) @db.Decimal(10, 2)
  claimStatus           String    @default("OPEN")
  claimNotes            String?   @db.Text
  createdBy             String?
  closedAt              DateTime?
  isDeleted             Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([date])
  @@index([status])
  @@index([isClaim])
  @@index([workOrderNumber])
  @@index([responsibleDepartment])
  @@index([responsibleDepartmentId])
  @@index([projectName])
  @@index([projectId])
  @@index([partId])
}

model supervision_projects {
  id                String                            @id @default(cuid())
  projectName       String
  projectId         String?
  projectType       String                            @default("MOLD")
  projectTypeId     String?
  workOrderNumber   String?
  supplierName      String?
  supplierId        String?
  location          String?
  supervisor        String?
  participants      String?                           @db.LongText
  plannedStartAt    DateTime?
  plannedEndAt      DateTime?
  actualStartAt     DateTime?
  actualEndAt       DateTime?
  stage             String?
  progressPercent   Int                               @default(0)
  status            String                            @default("PLANNED")
  riskLevel         String                            @default("LOW")
  summary           String?                           @db.Text
  isDeleted         Boolean                           @default(false)
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt
  dailyReports      supervision_daily_reports[]
  issues            supervision_issues[]
  planTasks         supervision_plan_tasks[]
  reportTaskUpdates supervision_report_task_updates[]

  @@index([projectName])
  @@index([projectType])
  @@index([projectTypeId])
  @@index([workOrderNumber])
  @@index([supplierName])
  @@index([supplierId])
  @@index([projectId])
  @@index([status])
  @@index([riskLevel])
  @@index([isDeleted])
}

model supervision_plan_tasks {
  id                String                            @id @default(cuid())
  projectId         String
  taskNo            String
  taskName          String
  durationText      String?
  durationDays      Int?
  plannedStartAt    DateTime?
  plannedEndAt      DateTime?
  actualStartAt     DateTime?
  actualEndAt       DateTime?
  progressPercent   Int                               @default(0)
  plannedQuantity   Decimal                           @default(1.00) @db.Decimal(12, 2)
  completedQuantity Decimal                           @default(0.00) @db.Decimal(12, 2)
  quantityUnit      String                            @default("项")
  weight            Decimal                           @default(1.00) @db.Decimal(10, 2)
  predecessorText   String?
  resourceName      String?
  status            String                            @default("NOT_STARTED")
  riskLevel         String                            @default("NORMAL")
  riskReason        String?                           @db.Text
  lastReportAt      DateTime?
  lastReportId      String?
  sourceFileName    String?
  sourceFileUrl     String?                           @db.Text
  sortOrder         Int                               @default(0)
  parentId          String?
  outlineLevel      Int                               @default(1)
  outlineNumber     String?
  isSummary         Boolean                           @default(false)
  isDeleted         Boolean                           @default(false)
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt
  project           supervision_projects              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent            supervision_plan_tasks?           @relation("PlanTaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          supervision_plan_tasks[]          @relation("PlanTaskTree")
  reportUpdates     supervision_report_task_updates[]
  issues            supervision_issues[]

  @@index([projectId])
  @@index([taskNo])
  @@index([plannedStartAt])
  @@index([plannedEndAt])
  @@index([status])
  @@index([riskLevel])
  @@index([lastReportAt])
  @@index([isDeleted])
  @@index([parentId])
  @@index([outlineLevel])
}

model supervision_daily_reports {
  id                 String                            @id @default(cuid())
  projectId          String
  reportDate         DateTime
  reporter           String
  location           String?
  progressPercent    Int                               @default(0)
  completedMilestone String?
  workContent        String?                           @db.Text
  issueSummary       String?                           @db.Text
  tomorrowPlan       String?                           @db.Text
  coordinationNeeded String?                           @db.Text
  manpower           String?                           @db.Text
  weather            String?
  attachments        String?                           @db.LongText
  isDeleted          Boolean                           @default(false)
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  project            supervision_projects              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskUpdates        supervision_report_task_updates[]

  @@index([projectId])
  @@index([reportDate])
  @@index([reporter])
  @@index([isDeleted])
}

model supervision_report_task_updates {
  id                String                    @id @default(cuid())
  reportId          String
  projectId         String
  taskId            String
  taskNo            String
  taskName          String
  progressPercent   Int                       @default(0)
  plannedQuantity   Decimal                   @default(1.00) @db.Decimal(12, 2)
  completedQuantity Decimal                   @default(0.00) @db.Decimal(12, 2)
  dailyQuantity     Decimal                   @default(0.00) @db.Decimal(12, 2)
  quantityUnit      String                    @default("项")
  status            String                    @default("IN_PROGRESS")
  riskReason        String?                   @db.Text
  workContent       String?                   @db.Text
  nextPlan          String?                   @db.Text
  photos            String?                   @db.LongText
  createdAt         DateTime                  @default(now())
  report            supervision_daily_reports @relation(fields: [reportId], references: [id], onDelete: Cascade)
  task              supervision_plan_tasks    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project           supervision_projects      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([projectId])
  @@index([taskId])
  @@index([status])
  @@index([createdAt])
}

model supervision_issues {
  id                  String                      @id @default(cuid())
  projectId           String
  issueNo             String                      @unique
  issueType           String                      @default("QUALITY")
  issueTypeId         String?
  description         String                      @db.Text
  responsibleUnit     String?
  severity            String                      @default("minor")
